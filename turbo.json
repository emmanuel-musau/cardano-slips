{
  "$schema": "https://turbo.build/schema.json",

  // `spec/**` is global because `core` reads the examples from outside its own
  // directory, and per-package inputs cannot reach up out of the package.
  "globalDependencies": ["tsconfig.base.json", ".npmrc", "spec/**"],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },

    // NodeNext resolves a workspace dependency through its emitted .d.ts, so
    // `^build` is not optional. Same reason `test` waits on it.
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },

    // Flat-config ESLint reads source, not build output — no upstream build.
    "lint": {
      "outputs": []
    },

    // Root-level sources are in no package, so `turbo run lint` would skip them.
    "//#lint:root": {
      "inputs": ["eslint.config.js", "test/**", "*.ts", "*.js", "*.mjs", "*.cjs"],
      "outputs": []
    },

    // Same for the repo tests' own types — no package tsconfig includes them.
    "//#typecheck:repo": {
      "inputs": ["test/**", "tsconfig.test.json"],
      "outputs": []
    },

    // Same reason as `//#lint:root`. Anything these tests read from disk
    // belongs in `inputs`, or turbo serves a cached pass over what it never read.
    "//#test:repo": {
      "inputs": ["test/**", "spec/**", "vitest.config.ts", ".changeset/config.json", "*/*/package.json"],
      "outputs": []
    },

    // Uncached: Prettier reads the whole tree, and an `inputs` glob that drifted
    // out of sync would serve a cached pass over files it never looked at.
    "//#format:check": {
      "cache": false,
      "outputs": []
    },

    "clean": {
      "cache": false
    }
  }
}
