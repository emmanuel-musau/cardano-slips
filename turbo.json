{
  "$schema": "https://turbo.build/schema.json",

  // Root configs every package inherits. A change here must invalidate every
  // cached task, or a tightened compiler flag silently never re-runs.
  // The lockfile and pnpm-workspace.yaml are hashed by turbo already.
  //
  // `spec/**` is global because the examples are read from outside the package
  // that reads them: `core` decodes every payload under `spec/examples` to
  // prove its schemas and the CIP's agree, and turbo's per-package inputs
  // cannot reach up out of the package directory. Without it, an edit to a
  // schema or an example would be answered with a cached pass over the version
  // nothing read — the same false green the `format:check` note below refuses.
  "globalDependencies": ["tsconfig.base.json", ".npmrc", "spec/**"],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },

    // `^build` is not optional here: NodeNext resolves a workspace dependency
    // through its emitted .d.ts, so typechecking `flow` requires `core` to
    // have been built. Same reason `test` waits on it.
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },

    // Flat-config ESLint reads source, not build output — no upstream build.
    "lint": {
      "outputs": []
    },

    // Root-level sources are in no workspace package, so `turbo run lint`
    // would skip them entirely — eslint.config.js and vitest.config.ts would
    // go unlinted, and CI would be green having checked nothing. These two
    // `//#` tasks run against the repo root and are invoked by `pnpm lint`
    // alongside the per-package task.
    "//#lint:root": {
      "inputs": ["eslint.config.js", "test/**", "*.ts", "*.js", "*.mjs", "*.cjs"],
      "outputs": []
    },

    // Same for the repo tests' own types — no package tsconfig includes them.
    "//#typecheck:repo": {
      "inputs": ["test/**", "tsconfig.test.json"],
      "outputs": []
    },

    // Repo-level invariants (test/), in no workspace package — same reason
    // `//#lint:root` exists. `turbo run test` alone would never run them.
    // `spec/**` is an input because the CIP structure is asserted in
    // test/spec-skeleton.test.ts: without it turbo serves a cached pass over a
    // draft it never read, which is the same false green the format:check note
    // below refuses. Anything else these tests read from disk belongs here too.
    "//#test:repo": {
      "inputs": ["test/**", "spec/**", "vitest.config.ts", ".changeset/config.json", "*/*/package.json"],
      "outputs": []
    },

    // Deliberately uncached. Prettier reads the whole tree — every md, json,
    // yaml and source file in and out of the packages — and an `inputs` glob
    // that drifts out of sync with that would serve a cached pass for files
    // it never looked at. A false green on formatting is worse than the
    // second this takes.
    "//#format:check": {
      "cache": false,
      "outputs": []
    },

    "clean": {
      "cache": false
    }
  }
}
