{
  "$schema": "http://json.schemastore.org/tsconfig",

  // Solution config, owning no sources: `tsc --build` here typechecks the whole
  // workspace in dependency order. One reference per package.
  "extends": "./tsconfig.base.json",
  "include": [],
  "references": [
    { "path": "packages/core/tsconfig.src.json" },
    { "path": "packages/flow/tsconfig.src.json" },
    { "path": "packages/server/tsconfig.src.json" },
    { "path": "packages/verifier/tsconfig.src.json" },
    { "path": "examples/slips/tsconfig.src.json" }
  ]
}
