{
  "$schema": "http://json.schemastore.org/tsconfig",

  // Solution config. It owns no sources of its own — it points at the
  // packages, so `tsc --build` at the root typechecks the whole workspace in
  // dependency order. Add a reference per package as each one lands.
  "extends": "./tsconfig.base.json",
  "include": [],
  "references": [
    { "path": "packages/core/tsconfig.src.json" },
    { "path": "packages/flow/tsconfig.src.json" },
    { "path": "packages/server/tsconfig.src.json" },
    { "path": "packages/verifier/tsconfig.src.json" }
  ]
}
