{
  "$schema": "http://json.schemastore.org/tsconfig",

  // Compiler options only; every package supplies its own inputs. Mirrors the
  // evolution-sdk base config per ADR-0003.
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    // Off upstream too. Tightening them for the effects arithmetic is its own decision.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // Ambient globals out by default; a package opts in with `"types": ["node"]`.
    "types": [],

    // Declarations are what make a workspace dependency resolvable, which is why
    // turbo's `typecheck` task depends on `^build`.
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "removeComments": false,
    "noEmitOnError": false,

    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false,
    "checkJs": false,
    "noErrorTruncation": false
  }
}
