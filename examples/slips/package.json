{
  "name": "@cardano-slips/example-slips",
  "version": "0.0.0",
  "description": "The delegate and tip Slips that the server tests, the client tests and the docs all read from",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.src.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist build coverage .tsbuildinfo .turbo"
  },
  "dependencies": {
    "@cardano-slips/core": "workspace:^",
    "@cardano-slips/server": "workspace:^",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
