{
  "$schema": "http://json.schemastore.org/tsconfig",

  // Emitted to `build/src`, never `dist`, so a typecheck cannot half-overwrite
  // the build turbo has cached. tsconfig.build.json writes `dist`.
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "build/src",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo"
  }
}
