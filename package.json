{
  "name": "cardano-slips",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cardano Slips — an open specification and TypeScript SDK that turns a shareable URL into a signable Cardano transaction",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck //#typecheck:repo",
    "typecheck:repo": "tsc -p test/tsconfig.json",
    "test": "turbo run test //#test:repo",
    "test:attacks": "turbo run //#attack-examples",
    "attack-examples": "vitest run --project verifier packages/verifier/test/regression.test.ts",
    "test:repo": "vitest run --project repo",
    "test:watch": "vitest",
    "coverage": "turbo run test -- --coverage",
    "lint": "turbo run lint //#lint:root //#format:check",
    "lint:root": "eslint .",
    "lint:fix": "turbo run lint //#lint:root -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf .turbo",
    "changeset": "changeset",
    "version:packages": "changeset version && pnpm install --lockfile-only",
    "release": "turbo run build --filter='./packages/*' && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "8.20.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
