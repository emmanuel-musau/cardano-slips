{
  "$schema": "http://json.schemastore.org/tsconfig",

  // Typechecked, never emitted. The reference lets a test import
  // `../src/index.js` through the emitted declarations, exactly as a consumer will.
  "extends": "../../tsconfig.test.json",
  "include": ["test", "vitest.config.ts"],
  "references": [{ "path": "./tsconfig.src.json" }],
  "compilerOptions": {
    "tsBuildInfoFile": ".tsbuildinfo/test.tsbuildinfo",

    // Tests render components, so they need JSX and React's types on top of
    // the Node globals the shared test config already supplies.
    "jsx": "react-jsx",
    "types": ["node", "react"]
  }
}
