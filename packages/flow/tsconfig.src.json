{
  "$schema": "http://json.schemastore.org/tsconfig",

  // The shippable sources, emitted to `build/src` for the editor and
  // `pnpm typecheck`. `dist` comes from tsconfig.build.json instead, so a
  // typecheck can never half-overwrite a build turbo has cached.
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "build/src",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",

    // Automatic runtime: no `import React` per file, and no second copy of React for consumers.
    "jsx": "react-jsx",

    // React opted in, Node deliberately not: a `process` that typechecks is one an author reaches for.
    "types": ["react"]
  }
}
