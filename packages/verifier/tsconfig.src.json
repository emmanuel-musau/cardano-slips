{
  "$schema": "http://json.schemastore.org/tsconfig",

  // The shippable sources, emitted to `build/src` for the editor and
  // `pnpm typecheck`. `dist` comes from tsconfig.build.json instead, so a
  // typecheck can never half-overwrite a build turbo has cached.
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "build/src",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo"
  }
}
