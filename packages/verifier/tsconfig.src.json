{
  "$schema": "http://json.schemastore.org/tsconfig",

  // The shippable sources. `tsc -b` on this typechecks and emits declarations
  // to `build/src`, which is what the editor and `pnpm typecheck` use. The
  // published artefact comes from tsconfig.build.json — keeping the two out
  // of one directory means a typecheck can never half-overwrite a build that
  // turbo has already cached as `dist`.
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "build/src",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo"
  }
}
