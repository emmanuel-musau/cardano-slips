{
  "$schema": "http://json.schemastore.org/tsconfig",

  // For the editor, and nothing else. `../tsconfig.test.json` cannot be
  // referenced from the package's solution file — a referenced project must be
  // composite and a composite project must emit — so tsserver finds no project
  // for a test file and falls back to defaults without `@types/node`. This sits
  // where tsserver looks first. `pnpm typecheck` still runs the config above.
  "extends": "../tsconfig.test.json",
  "include": ["**/*.ts", "**/*.tsx"]
}
