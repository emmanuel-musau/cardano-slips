{
  "name": "@cardano-slips/core",
  "version": "0.0.2",
  "description": "The shared contract for Cardano Slips: payload schemas, URL resolution rules, and the error codes",
  "keywords": [
    "cardano",
    "cardano-slips",
    "cip-30",
    "blinks",
    "transaction"
  ],
  "homepage": "https://github.com/emmanuel-musau/cardano-slips/tree/main/packages/core#readme",
  "bugs": "https://github.com/emmanuel-musau/cardano-slips/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmanuel-musau/cardano-slips.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.src.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist build coverage .tsbuildinfo .turbo"
  },
  "dependencies": {
    "effect": "^3.22.1"
  }
}
