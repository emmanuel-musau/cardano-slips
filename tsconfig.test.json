{
  "$schema": "http://json.schemastore.org/tsconfig",

  // Shared test config. Tests are typechecked, never emitted, so the
  // declaration/composite settings the base turns on are turned back off.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,

    // Only tests get Node globals; sources inherit `types: []` and opt in themselves.
    "types": ["node"]
  }
}
